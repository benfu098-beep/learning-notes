import asyncio
import time
from datetime import datetime


async def fetch(name, delay):
    await asyncio.sleep(delay)
    return f"{name} 完成"


async def main():
    print(datetime.now().strftime("%Y-%m-%d %H:%M:%S"))
    results = await asyncio.gather(
        fetch("A", 1),
        fetch("B", 2),
        fetch("C", 1),
    )
    print(results)  # ['A 完成', 'B 完成', 'C 完成']
    print(datetime.now().strftime("%Y-%m-%d %H:%M:%S"))


asyncio.run(main())
