# 复制成 .env 后填入真实值（.env 已被 .gitignore 忽略，不会上传）
#
#   cp .env.example .env

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=你的密码
MYSQL_DB=learning_notes

# PostgreSQL
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=你的系统用户名
PG_PASSWORD=
PG_DB=learning_notes

# 供 SQLAlchemy 使用（异步）
DATABASE_URL=mysql+aiomysql://root:你的密码@127.0.0.1:3306/learning_notes
